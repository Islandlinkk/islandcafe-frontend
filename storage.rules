rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // User profile images - users can upload and read their own profile images
    match /user_images/{userId}.jpg {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // User feedback images stored in user_images/feedback/ folder
    // Allows authenticated users to upload and read feedback images
    match /user_images/feedback/{fileName} {
      // Allow authenticated users to read and write feedback images
      // File size limit: 10MB
      allow read: if request.auth != null;
      allow write: if request.auth != null && 
                       request.auth.uid != null &&
                       request.resource.size < 10 * 1024 * 1024; // 10MB limit
      allow delete: if request.auth != null;
    }
    
    // Legacy support for user_feedback path (if needed)
    match /user_feedback/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && 
                       request.auth.uid != null &&
                       request.resource.size < 10 * 1024 * 1024; // 10MB limit
      allow delete: if request.auth != null;
    }
    
    // Default deny all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

