rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // User images - users can upload and read their own images
    match /user_images/{userId}.jpg {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // User feedback images - authenticated users can upload and read feedback images
    match /user_feedback/{fileName} {
      // Allow authenticated users to read and write feedback images
      // More permissive rules for feedback images
      allow read: if request.auth != null;
      allow write: if request.auth != null && 
                       request.auth.uid != null &&
                       request.resource.size < 10 * 1024 * 1024; // 10MB limit
      allow delete: if request.auth != null;
    }
    
    // Default deny all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

